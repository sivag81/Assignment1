{
  "info": {
    "name": "Online Bookstore Assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "book_url",
      "value": "http://localhost:8001"
    },
    {
      "key": "order_url",
      "value": "http://localhost:8002"
    },
    {
      "key": "book_id",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create book",
      "request": {
        "method": "POST",
        "url": "{{book_url}}/books",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Distributed Systems Basics\",\"author\":\"Sample Author\",\"price\":\"450.00\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Book created\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"book_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get book",
      "request": {
        "method": "GET",
        "url": "{{book_url}}/books/{{book_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Book found\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create order",
      "request": {
        "method": "POST",
        "url": "{{order_url}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"book_id\":{{book_id}},\"quantity\":2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Order created\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"order_id\", pm.response.json().id);",
              "pm.test(\"Total is exact\", () => pm.expect(pm.response.json().total_price).to.eql(\"900.00\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get order",
      "request": {
        "method": "GET",
        "url": "{{order_url}}/orders/{{order_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Order found\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid quantity",
      "request": {
        "method": "POST",
        "url": "{{order_url}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"book_id\":{{book_id}},\"quantity\":0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid quantity rejected\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown book",
      "request": {
        "method": "POST",
        "url": "{{order_url}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"book_id\":2147483647,\"quantity\":1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Unknown book rejected\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
